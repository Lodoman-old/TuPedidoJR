# Copia este archivo a .env.production y cambia todos los valores.
# Coolify también puede inyectar estas variables desde su panel.

APP_NAME=TuPedidoJR
DEBUG=false
NOINDEX=true

# Genera una clave segura, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=tupedido
# Usa una contraseña URL-safe: letras, números, guiones y guiones bajos.
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=tupedidojr

# Dominio público con HTTPS. Ejemplo: https://beta.tudominio.com
APP_URL=https://beta.tudominio.com
CORS_ORIGINS=https://beta.tudominio.com
ALLOWED_HOSTS=beta.tudominio.com,localhost,127.0.0.1

# Mercado Pago (opcional; déjalo vacío si aún no se usa)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=

# FCM / notificaciones push.
# El service account es privado: pégalo minificado en una línea.
PUSH_ENABLED=true
FCM_SERVICE_ACCOUNT_JSON=PEGA_AQUI_EL_JSON_MINIFICADO_DE_LA_SERVICE_ACCOUNT
PUSH_ANDROID_CONFIG_JSON={"project_id":"tupedidojr-30f28","mobilesdk_app_id":"1:88387960123:android:99ae008757264de1c64b1e","api_key":"AIzaSyBqdmulTYLvfsc61OSU_YJuDNrxWHqZm3s","gcm_defaultSenderId":"88387960123","storage_bucket":"tupedidojr-30f28.firebasestorage.app"}
# Opcional para notificaciones web:
PUSH_WEB_CONFIG_JSON=
PUSH_VAPID_KEY=

# Solo para crear el primer administrador con scripts/create_admin.py
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_DE_ADMIN
